// Prisim CRM database schema (PostgreSQL)
// All timestamps are stored in UTC. UUID primary keys for business entities.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Users, teams, roles ─────────────────────────

model User {
  id              String       @id @default(uuid()) @db.Uuid
  fullName        String
  email           String       @unique
  phone           String? // agent phone in E.164, used for click-to-call
  // Sign-in is handled by Supabase Auth. Filled in the first time this person signs in.
  authUserId      String?      @unique
  passwordHash    String? // legacy, unused
  isActive        Boolean      @default(true)
  timezone        String       @default("Asia/Kolkata")
  /// Main team, shown where only one fits. teamMemberships holds every team, this one included.
  teamId          String?      @db.Uuid
  team            Team?        @relation("TeamMembers", fields: [teamId], references: [id])
  teamMemberships TeamMember[]
  lastLoginAt     DateTime?
  // Deleted users stay as rows so past calls, leads and audit entries keep their name.
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  roles                 UserRole[]
  permissionOverrides   UserPermission[]
  ledTeams              Team[]               @relation("TeamLeader")
  assignedLeads         Lead[]               @relation("LeadOwner")
  assignments           LeadAssignment[]     @relation("AssignmentUser")
  assignmentsMade       LeadAssignment[]     @relation("AssignmentActor")
  statusChanges         LeadStatusHistory[]
  notes                 LeadNote[]
  followUps             FollowUp[]           @relation("FollowUpOwner")
  followUpsCreated      FollowUp[]           @relation("FollowUpCreator")
  calls                 CallLog[]
  tasksAssigned         Task[]               @relation("TaskAssignee")
  taskAssignments       TaskAssignee[]
  quotationsCreated     Quotation[]
  acctExpensesSubmitted AcctExpense[]        @relation("AcctExpenseSubmitter")
  acctExpensesReviewed  AcctExpense[]        @relation("AcctExpenseReviewer")
  acctProjectsCreated   AcctProject[]        @relation("AcctProjectCreator")
  acctInvoicesCreated   AcctInvoice[]        @relation("AcctInvoiceCreator")
  messagesSent          Message[]            @relation("MessageSender")
  messagesReceived      Message[]            @relation("MessageRecipient")
  messageReads          MessageRead[]
  postingPeriodsCreated PostingPeriod[]
  tasksCreated          Task[]               @relation("TaskCreator")
  taskComments          TaskComment[]
  taskActivities        TaskActivity[]
  feedbackSubmitted     Feedback[]           @relation("FeedbackSubmitter")
  feedbackAssigned      Feedback[]           @relation("FeedbackAssignee")
  feedbackResponses     FeedbackResponse[]
  attachments           Attachment[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  clientsCreated        Client[]             @relation("ClientCreator")
  clientWorkCreated     ClientWork[]         @relation("ClientWorkCreator")
  clientWorkAssigned    ClientWorkAssignee[]
  clientWorkUpdates     ClientWorkUpdate[]
  mediaAssigned         MediaItem[]          @relation("MediaAssignee")
  mediaCreated          MediaItem[]          @relation("MediaCreator")
  mediaExpenses         MediaExpense[]
  seoAccountsCreated    SeoAccount[]
  seoAssignments        SeoAssignee[]
  seoUpdates            SeoUpdate[]

  @@index([teamId])
  @@map("users")
}

model Team {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  leaderId    String?      @db.Uuid
  leader      User?        @relation("TeamLeader", fields: [leaderId], references: [id])
  members     User[]       @relation("TeamMembers")
  memberships TeamMember[]
  tasks       Task[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("teams")
}

/// A person's membership of a team. People can be in several teams.
model TeamMember {
  teamId    String   @db.Uuid
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id            String           @id @default(uuid()) @db.Uuid
  key           String           @unique
  group         String
  description   String
  roles         RolePermission[]
  userOverrides UserPermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum PermissionEffect {
  GRANT
  DENY
}

/// Per-user exceptions on top of role permissions.
/// Effective permissions = role permissions + GRANTs - DENYs.
model UserPermission {
  userId       String           @db.Uuid
  permissionId String           @db.Uuid
  effect       PermissionEffect
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ───────────────────────── Leads ─────────────────────────

enum LeadStatus {
  NEW
  UNASSIGNED
  ASSIGNED
  CONTACT_ATTEMPTED
  CONTACTED
  INTERESTED
  FOLLOW_UP_REQUIRED
  CONVERTED
  LOST
  INVALID
  DUPLICATE
}

model LeadSource {
  id           String        @id @default(uuid()) @db.Uuid
  key          String        @unique // e.g. meta_ads, manual
  name         String
  leads        Lead[]
  deletedLeads DeletedLead[]
  createdAt    DateTime      @default(now())

  @@map("lead_sources")
}

/// Source ids of deleted leads, so a sheet re-read or a repeated webhook doesn't bring them back.
model DeletedLead {
  sourceId       String     @db.Uuid
  source         LeadSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalLeadId String
  deletedAt      DateTime   @default(now())

  @@id([sourceId, externalLeadId])
  @@map("deleted_leads")
}

model Lead {
  id              String     @id @default(uuid()) @db.Uuid
  externalLeadId  String?
  sourceId        String     @db.Uuid
  source          LeadSource @relation(fields: [sourceId], references: [id])
  fullName        String
  phoneE164       String?
  email           String?
  city            String?
  campaignName    String?
  adsetName       String?
  adName          String?
  formName        String?
  sourceCreatedAt DateTime?
  // Original values from the source system. CRM-managed fields above may be edited
  // by users; sync never overwrites fields a user has changed (see editedFields).
  sourceData      Json?
  editedFields    String[]   @default([])
  assignedUserId  String?    @db.Uuid
  assignedUser    User?      @relation("LeadOwner", fields: [assignedUserId], references: [id])
  status          LeadStatus @default(NEW)
  closeReason     String?
  duplicateOfId   String?    @db.Uuid
  duplicateOf     Lead?      @relation("LeadDuplicates", fields: [duplicateOfId], references: [id])
  duplicates      Lead[]     @relation("LeadDuplicates")
  lastContactedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  assignments   LeadAssignment[]
  statusHistory LeadStatusHistory[]
  notes         LeadNote[]
  followUps     FollowUp[]
  calls         CallLog[]
  tasks         Task[]

  @@unique([sourceId, externalLeadId])
  @@index([assignedUserId, status])
  @@index([status])
  @@index([phoneE164])
  @@index([email])
  @@index([campaignName])
  @@index([createdAt])
  @@map("leads")
}

model LeadAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  leadId       String    @db.Uuid
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId       String    @db.Uuid
  user         User      @relation("AssignmentUser", fields: [userId], references: [id])
  assignedById String?   @db.Uuid
  assignedBy   User?     @relation("AssignmentActor", fields: [assignedById], references: [id])
  method       String    @default("manual") // manual | round_robin | workload
  reason       String?
  assignedAt   DateTime  @default(now())
  endedAt      DateTime?

  @@index([leadId, endedAt])
  @@index([userId])
  @@map("lead_assignments")
}

model LeadStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  leadId     String      @db.Uuid
  lead       Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromStatus LeadStatus?
  toStatus   LeadStatus
  reason     String?
  actorId    String?     @db.Uuid
  actor      User?       @relation(fields: [actorId], references: [id])
  createdAt  DateTime    @default(now())

  @@index([leadId, createdAt])
  @@map("lead_status_history")
}

model LeadNote {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String   @db.Uuid
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("lead_notes")
}

// ───────────────────────── Follow-ups ─────────────────────────

enum FollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model FollowUp {
  id              String               @id @default(uuid()) @db.Uuid
  leadId          String               @db.Uuid
  lead            Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId         String               @db.Uuid
  owner           User                 @relation("FollowUpOwner", fields: [ownerId], references: [id])
  createdById     String               @db.Uuid
  createdBy       User                 @relation("FollowUpCreator", fields: [createdById], references: [id])
  type            String               @default("call") // call | whatsapp | email | meeting | other
  dueAt           DateTime
  note            String?
  status          FollowUpStatus       @default(PENDING)
  outcome         String?
  completedAt     DateTime?
  cancelReason    String?
  rescheduleCount Int                  @default(0)
  reminderSentAt  DateTime?
  overdueNotified Boolean              @default(false)
  reschedules     FollowUpReschedule[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([ownerId, status, dueAt])
  @@index([leadId])
  @@index([status, dueAt])
  @@map("follow_ups")
}

model FollowUpReschedule {
  id         String   @id @default(uuid()) @db.Uuid
  followUpId String   @db.Uuid
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  fromDueAt  DateTime
  toDueAt    DateTime
  reason     String?
  actorId    String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@map("follow_up_reschedules")
}

// ───────────────────────── Calls ─────────────────────────

enum CallDirection {
  OUTBOUND
  INBOUND
}

enum CallStatus {
  INITIATED
  RINGING
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELED
}

model CallLog {
  id              String        @id @default(uuid()) @db.Uuid
  leadId          String        @db.Uuid
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId          String        @db.Uuid
  user            User          @relation(fields: [userId], references: [id])
  provider        String        @default("manual") // manual | exotel | mock
  providerCallId  String?
  direction       CallDirection @default(OUTBOUND)
  fromNumber      String?
  toNumber        String?
  status          CallStatus    @default(COMPLETED)
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  // Employee disposition: CONNECTED, NO_ANSWER, BUSY, INTERESTED, CALLBACK,
  // NOT_INTERESTED, WRONG_NUMBER, SWITCHED_OFF, CONVERTED
  outcome         String?
  notes           String?
  recordingUrl    String? // provider URL (fetched via proxy, never exposed raw)
  recordingKey    String? // locally stored / uploaded recording
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([provider, providerCallId])
  @@index([leadId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("call_logs")
}

// ───────────────────────── Tasks ─────────────────────────

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

model Task {
  id              String       @id @default(uuid()) @db.Uuid
  number          Int          @unique @default(autoincrement())
  title           String
  description     String?
  createdById     String       @db.Uuid
  createdBy       User         @relation("TaskCreator", fields: [createdById], references: [id])
  assigneeId      String?      @db.Uuid
  assignee        User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  teamId          String?      @db.Uuid
  team            Team?        @relation(fields: [teamId], references: [id])
  leadId          String?      @db.Uuid
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  parentId        String?      @db.Uuid
  parent          Task?        @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks        Task[]       @relation("Subtasks")
  priority        TaskPriority @default(MEDIUM)
  status          TaskStatus   @default(TODO)
  requiresReview  Boolean      @default(false)
  reviewNote      String?
  position        Float        @default(0)
  startAt         DateTime?
  dueAt           DateTime?
  completedAt     DateTime?
  overdueNotified Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  /// Everyone working on the task. assigneeId mirrors the first of them, for reports and older screens.
  assignees   TaskAssignee[]
  /// Clients this task was work for.
  clients     TaskClient[]
  comments    TaskComment[]
  checklist   TaskChecklistItem[]
  attachments Attachment[]
  activities  TaskActivity[]

  @@index([assigneeId, status])
  @@index([teamId, status])
  @@index([status, dueAt])
  @@map("tasks")
}

model TaskClient {
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  clientId  String   @db.Uuid
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, clientId])
  @@index([clientId])
  @@map("task_clients")
}

model TaskAssignee {
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskChecklistItem {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@map("task_checklist_items")
}

model TaskComment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @db.Uuid
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("task_comments")
}

model TaskActivity {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("task_activities")
}

// ───────────────────────── Feedback & queries ─────────────────────────

enum FeedbackKind {
  FEEDBACK
  QUERY
}

enum FeedbackStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Feedback {
  id              String             @id @default(uuid()) @db.Uuid
  kind            FeedbackKind       @default(FEEDBACK)
  // Null when anonymous. Anonymous submitters are linked only through a keyed hash
  // so they can still see their own submissions; reviewers never see identity.
  submittedById   String?            @db.Uuid
  submittedBy     User?              @relation("FeedbackSubmitter", fields: [submittedById], references: [id])
  submitterHash   String?
  isAnonymous     Boolean            @default(false)
  category        String
  subject         String
  description     String
  priority        TaskPriority       @default(MEDIUM)
  status          FeedbackStatus     @default(SUBMITTED)
  assignedAdminId String?            @db.Uuid
  assignedAdmin   User?              @relation("FeedbackAssignee", fields: [assignedAdminId], references: [id])
  resolvedAt      DateTime?
  responses       FeedbackResponse[]
  attachments     Attachment[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([submittedById])
  @@index([submitterHash])
  @@map("feedback")
}

model FeedbackResponse {
  id            String          @id @default(uuid()) @db.Uuid
  feedbackId    String          @db.Uuid
  feedback      Feedback        @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  // Null author = reply from the anonymous submitter
  authorId      String?         @db.Uuid
  author        User?           @relation(fields: [authorId], references: [id])
  fromSubmitter Boolean         @default(false)
  body          String
  isInternal    Boolean         @default(false) // internal admin note, hidden from submitter
  statusChange  FeedbackStatus?
  createdAt     DateTime        @default(now())

  @@index([feedbackId, createdAt])
  @@map("feedback_responses")
}

// ───────────────────────── Clients ─────────────────────────
// A Super Admin records a client and posts pieces of work for it to any people.
// Assignees post progress updates; admins see every client, work item and update.

enum ClientStatus {
  ACTIVE
  ON_HOLD
  SUSPENDED
  COMPLETED
}

enum ClientWorkStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED
  DONE
}

model Client {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  company        String?
  contactName    String?
  email          String?
  phone          String?
  notes          String?
  status         ClientStatus    @default(ACTIVE)
  createdById    String          @db.Uuid
  createdBy      User            @relation("ClientCreator", fields: [createdById], references: [id])
  works          ClientWork[]
  mediaItems     MediaItem[]
  postingPeriods PostingPeriod[]
  tasks          TaskClient[]
  quotations     Quotation[]
  acctProjects   AcctProject[]
  acctInvoices   AcctInvoice[]
  seoAccounts    SeoAccount[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@map("clients")
}

model ClientWork {
  id          String               @id @default(uuid()) @db.Uuid
  clientId    String               @db.Uuid
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    TaskPriority         @default(MEDIUM)
  status      ClientWorkStatus     @default(OPEN)
  dueAt       DateTime?
  completedAt DateTime?
  createdById String               @db.Uuid
  createdBy   User                 @relation("ClientWorkCreator", fields: [createdById], references: [id])
  assignees   ClientWorkAssignee[]
  updates     ClientWorkUpdate[]
  attachments Attachment[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([clientId, status])
  @@map("client_work")
}

model ClientWorkAssignee {
  workId    String     @db.Uuid
  work      ClientWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([workId, userId])
  @@index([userId])
  @@map("client_work_assignees")
}

model ClientWorkUpdate {
  id         String            @id @default(uuid()) @db.Uuid
  workId     String            @db.Uuid
  work       ClientWork        @relation(fields: [workId], references: [id], onDelete: Cascade)
  authorId   String            @db.Uuid
  author     User              @relation(fields: [authorId], references: [id])
  body       String?
  fromStatus ClientWorkStatus?
  toStatus   ClientWorkStatus?
  createdAt  DateTime          @default(now())

  @@index([workId, createdAt])
  @@map("client_work_updates")
}

// ───────────────────────── Files ─────────────────────────

model Attachment {
  id           String      @id @default(uuid()) @db.Uuid
  storageKey   String      @unique
  fileName     String
  mimeType     String
  sizeBytes    Int
  uploadedById String?     @db.Uuid // null for anonymous feedback
  uploadedBy   User?       @relation(fields: [uploadedById], references: [id])
  taskId       String?     @db.Uuid
  task         Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  feedbackId   String?     @db.Uuid
  feedback     Feedback?   @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  clientWorkId String?     @db.Uuid
  clientWork   ClientWork? @relation(fields: [clientWorkId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@map("attachments")
}

// ───────────────────────── Platform ─────────────────────────

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model IntegrationConfig {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique // google_sheets | telephony | assignment
  enabled   Boolean  @default(false)
  // Non-secret settings only. Secrets live in environment variables.
  config    Json     @default("{}")
  state     Json     @default("{}") // cursors, round-robin pointer, etc.
  updatedAt DateTime @updatedAt

  @@map("integration_configs")
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model SyncRun {
  id         String         @id @default(uuid()) @db.Uuid
  trigger    String // schedule | manual | retry | reconcile | csv | webhook
  source     String? // lead source key the rows were imported into (meta_ads, website, ...)
  status     SyncRunStatus  @default(RUNNING)
  rowsRead   Int            @default(0)
  created    Int            @default(0)
  updated    Int            @default(0)
  skipped    Int            @default(0)
  failed     Int            @default(0)
  error      String?
  startedAt  DateTime       @default(now())
  finishedAt DateTime?
  rowErrors  SyncRowError[]

  @@index([startedAt])
  @@map("sync_logs")
}

model SyncRowError {
  id             String   @id @default(uuid()) @db.Uuid
  syncRunId      String   @db.Uuid
  syncRun        SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  rowNumber      Int
  externalLeadId String?
  reason         String
  rawRow         Json
  resolved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([resolved])
  @@map("sync_row_errors")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model WebhookEvent {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String
  eventId     String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// ───── Media: production schedules and shoot expenses ─────

enum MediaKind {
  SHOOT
  REEL
  CONTENT
  IMAGE
}

enum MediaStatus {
  PLANNED
  IN_PROGRESS
  READY
  DONE
  CANCELLED
}

enum MediaExpenseCategory {
  MODEL
  LOCATION
  EQUIPMENT
  TRAVEL
  FOOD
  PROPS
  OTHER
}

/// One entry on a media schedule: a shoot, a reel to post, a piece of content to write, or an image to post.
model MediaItem {
  id          String         @id @default(uuid()) @db.Uuid
  kind        MediaKind
  title       String
  scheduledAt DateTime
  status      MediaStatus    @default(PLANNED)
  assigneeId  String?        @db.Uuid
  assignee    User?          @relation("MediaAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  clientId    String?        @db.Uuid
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  platform    String?
  location    String?
  models      String?
  link        String?
  notes       String?
  createdById String         @db.Uuid
  createdBy   User           @relation("MediaCreator", fields: [createdById], references: [id])
  expenses    MediaExpense[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([kind, scheduledAt])
  @@index([assigneeId])
  @@map("media_items")
}

/// Money spent on production: model fees, location, equipment and so on, optionally tied to a shoot.
model MediaExpense {
  id          String               @id @default(uuid()) @db.Uuid
  spentOn     DateTime             @db.Date
  category    MediaExpenseCategory
  payee       String
  description String?
  amount      Decimal              @db.Decimal(12, 2)
  paid        Boolean              @default(false)
  paidOn      DateTime?            @db.Date
  shootId     String?              @db.Uuid
  shoot       MediaItem?           @relation(fields: [shootId], references: [id], onDelete: SetNull)
  createdById String               @db.Uuid
  createdBy   User                 @relation(fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([spentOn])
  @@index([shootId])
  @@map("media_expenses")
}

// ───── SEO: who handles which client, and their daily updates ─────

enum SeoStatus {
  ACTIVE
  PAUSED
  ENDED
}

/// SEO work for one client (or one of a client's websites), and the people handling it.
model SeoAccount {
  id          String        @id @default(uuid()) @db.Uuid
  clientId    String        @db.Uuid
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  website     String?
  scope       String?
  status      SeoStatus     @default(ACTIVE)
  createdById String        @db.Uuid
  createdBy   User          @relation(fields: [createdById], references: [id])
  assignees   SeoAssignee[]
  updates     SeoUpdate[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId])
  @@map("seo_accounts")
}

model SeoAssignee {
  accountId String     @db.Uuid
  account   SeoAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([accountId, userId])
  @@index([userId])
  @@map("seo_assignees")
}

/// A daily note of SEO work done for a client, by the person who did it.
model SeoUpdate {
  id        String     @id @default(uuid()) @db.Uuid
  accountId String     @db.Uuid
  account   SeoAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  authorId  String     @db.Uuid
  author    User       @relation(fields: [authorId], references: [id])
  workDate  DateTime   @db.Date
  body      String
  link      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([accountId, workDate])
  @@index([authorId, workDate])
  @@map("seo_updates")
}

// ───── Mic: chat and voice messages, cleared every week ─────

enum MessageKind {
  TEXT
  VOICE
}

/// A chat or voice message to one person, or to everyone when recipientId is empty.
/// Everything is deleted at the start of each week (Monday 00:00 India time).
model Message {
  id          String        @id @default(uuid()) @db.Uuid
  senderId    String        @db.Uuid
  sender      User          @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String?       @db.Uuid
  recipient   User?         @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  kind        MessageKind
  body        String?
  audioKey    String?
  audioType   String?
  durationSec Int?
  reads       MessageRead[]
  createdAt   DateTime      @default(now())

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
  @@index([createdAt])
  @@map("messages")
}

model MessageRead {
  messageId String   @db.Uuid
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@id([messageId, userId])
  @@index([userId])
  @@map("message_reads")
}

// ───── Client posting calendar: lead periods, and the reel / AI poster planned for each date ─────

enum PostingStatus {
  NONE
  NOT_YET
  DONE
}

/// One lead period for a client (e.g. 22 Sep to 22 Oct), with its shoot date.
model PostingPeriod {
  id          String        @id @default(uuid()) @db.Uuid
  clientId    String        @db.Uuid
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  leadStart   DateTime      @db.Date
  leadEnd     DateTime      @db.Date
  shootDate   DateTime?     @db.Date
  notes       String?
  createdById String        @db.Uuid
  createdBy   User          @relation(fields: [createdById], references: [id])
  slots       PostingSlot[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId, leadStart])
  @@map("posting_periods")
}

/// A scheduled date: the reel or video and the AI poster planned for it, each with its own status.
model PostingSlot {
  id             String        @id @default(uuid()) @db.Uuid
  periodId       String        @db.Uuid
  period         PostingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  video          String?
  videoStatus    PostingStatus @default(NONE)
  poster         String?
  posterStatus   PostingStatus @default(NONE)
  leads          String?
  /// Last day a reminder went out for this date, so each day gets at most one.
  reminderSentOn DateTime?     @db.Date
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([periodId, date])
  @@index([date])
  @@map("posting_slots")
}

// ───── Quotations: shared by sales and accounts, printed in Prisim's quotation format ─────

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Quotation {
  id           String          @id @default(uuid()) @db.Uuid
  /// e.g. PR/DM/046
  number       String          @unique
  date         DateTime        @db.Date
  validityDays Int             @default(15)
  clientId     String?         @db.Uuid
  client       Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName   String
  address      String?
  /// [{ title, points: string[], qty, amount }]
  items        Json
  gstRate      Decimal         @default(18) @db.Decimal(5, 2)
  /// Statement of work, one entry per numbered line.
  terms        Json
  status       QuotationStatus @default(DRAFT)
  notes        String?
  createdById  String          @db.Uuid
  createdBy    User            @relation(fields: [createdById], references: [id])
  invoices     AcctInvoice[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([date])
  @@index([clientId])
  @@map("quotations")
}

// ───────────────────────── Accounting ─────────────────────────

enum AcctExpenseStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum AcctPaymentMethod {
  BANK_TRANSFER
  UPI
  CASH
  CARD
  CHEQUE
  OTHER
}

enum AcctProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Company details, invoice numbering and fiscal year. A single row (id 1).
model AcctSettings {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt

  @@map("acct_settings")
}

/// Expense categories; a category with a parent is a subcategory.
model AcctCategory {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  parentId      String?        @db.Uuid
  parent        AcctCategory?  @relation("AcctCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      AcctCategory[] @relation("AcctCategoryTree")
  monthlyBudget Decimal?       @db.Decimal(14, 2)
  annualBudget  Decimal?       @db.Decimal(14, 2)
  sortOrder     Int            @default(0)
  archived      Boolean        @default(false)
  expenses      AcctExpense[]
  createdAt     DateTime       @default(now())

  @@index([parentId])
  @@map("acct_categories")
}

model AcctVendor {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique
  phone     String?
  email     String?
  notes     String?
  expenses  AcctExpense[]
  createdAt DateTime      @default(now())

  @@map("acct_vendors")
}

model AcctExpense {
  id            String            @id @default(uuid()) @db.Uuid
  amount        Decimal           @db.Decimal(14, 2)
  dateIncurred  DateTime          @db.Date
  datePaid      DateTime?         @db.Date
  categoryId    String?           @db.Uuid
  category      AcctCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  vendorId      String?           @db.Uuid
  vendor        AcctVendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  projectId     String?           @db.Uuid
  project       AcctProject?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  paymentMethod AcctPaymentMethod @default(BANK_TRANSFER)
  status        AcctExpenseStatus @default(PENDING)
  description   String?
  tags          String[]          @default([])
  receiptKey    String?
  receiptName   String?
  receiptType   String?
  submittedById String            @db.Uuid
  submittedBy   User              @relation("AcctExpenseSubmitter", fields: [submittedById], references: [id])
  reviewedById  String?           @db.Uuid
  reviewedBy    User?             @relation("AcctExpenseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewComment String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([dateIncurred])
  @@index([status])
  @@index([categoryId])
  @@index([vendorId])
  @@index([projectId])
  @@index([submittedById])
  @@map("acct_expenses")
}

/// A job for a CRM client: first meeting, shoot, payment.
model AcctProject {
  id           String               @id @default(uuid()) @db.Uuid
  clientId     String               @db.Uuid
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title        String
  meetingDate  DateTime?            @db.Date
  shootStart   DateTime?            @db.Date
  shootEnd     DateTime?            @db.Date
  quotedAmount Decimal?             @db.Decimal(14, 2)
  status       AcctProjectStatus    @default(ACTIVE)
  notes        String?
  createdById  String               @db.Uuid
  createdBy    User                 @relation("AcctProjectCreator", fields: [createdById], references: [id])
  payments     AcctProjectPayment[]
  expenses     AcctExpense[]
  invoices     AcctInvoice[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([clientId])
  @@map("acct_projects")
}

/// Money received for a project outside an invoice (advance, balance and so on).
model AcctProjectPayment {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @db.Uuid
  project   AcctProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amount    Decimal           @db.Decimal(14, 2)
  paidOn    DateTime          @db.Date
  method    AcctPaymentMethod @default(BANK_TRANSFER)
  note      String?
  createdAt DateTime          @default(now())

  @@index([projectId])
  @@map("acct_project_payments")
}

model AcctInvoice {
  id            String               @id @default(uuid()) @db.Uuid
  /// e.g. PI-26-001
  number        String               @unique
  date          DateTime             @db.Date
  dueDate       DateTime?            @db.Date
  clientId      String?              @db.Uuid
  client        Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName    String
  /// { contactPerson, phone, email, gstin, address }
  clientDetails Json
  /// [{ description, qty, rate }]
  items         Json
  discount      Decimal              @default(0) @db.Decimal(14, 2)
  gstRate       Decimal              @default(18) @db.Decimal(5, 2)
  /// Mode / terms of payment, printed in the invoice header.
  notes         String?
  /// Header boxes: { deliveryNote, referenceNo, otherReferences, buyerOrderNo, buyerOrderDate, dispatchDocNo, deliveryNoteDate, dispatchedThrough, destination, termsOfDelivery }
  extra         Json?
  /// Consignee (ship to) when different from the buyer: { name, address, gstin, stateCode }
  shipTo        Json?
  terms         Json
  preparedBy    String?
  quotationId   String?              @db.Uuid
  quotation     Quotation?           @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  projectId     String?              @db.Uuid
  project       AcctProject?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cancelled     Boolean              @default(false)
  payments      AcctInvoicePayment[]
  createdById   String               @db.Uuid
  createdBy     User                 @relation("AcctInvoiceCreator", fields: [createdById], references: [id])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([date])
  @@index([clientId])
  @@index([projectId])
  @@map("acct_invoices")
}

model AcctInvoicePayment {
  id        String            @id @default(uuid()) @db.Uuid
  invoiceId String            @db.Uuid
  invoice   AcctInvoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal           @db.Decimal(14, 2)
  paidOn    DateTime          @db.Date
  method    AcctPaymentMethod @default(BANK_TRANSFER)
  note      String?
  createdAt DateTime          @default(now())

  @@index([invoiceId])
  @@map("acct_invoice_payments")
}
