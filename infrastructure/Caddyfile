# Set DOMAIN in .env (e.g. crm.prisim.in). Caddy gets and renews the HTTPS certificate automatically.
{$DOMAIN:localhost} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Sign-in and own-account endpoints are served by the FastAPI auth service.
	handle /api/v1/auth/* {
		reverse_proxy auth:4100
	}
	handle /api/* {
		reverse_proxy api:4000
	}
	handle /health {
		reverse_proxy api:4000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
	request_body {
		max_size 30MB
	}
}
