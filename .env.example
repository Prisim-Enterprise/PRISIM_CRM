# ── Core ──────────────────────────────────────────────
# Local database. For Supabase, use the Session pooler string (Connect button) with
# ?sslmode=require&connection_limit=5 on the end. URL-encode symbols in the password (@ is %40).
DATABASE_URL="postgresql://prisim:prisim_dev@localhost:5433/prisim_crm"
# Used to link anonymous feedback to its submitter without revealing identity
FEEDBACK_HASH_SECRET="change-me-too"
APP_TIMEZONE="Asia/Kolkata"
DEFAULT_COUNTRY="IN"
PORT=4000
WEB_ORIGIN="http://localhost:5173"
# Public base URL of the API, used for telephony status callbacks
PUBLIC_API_URL="http://localhost:4000"
STORAGE_DIR="./storage"

# ── Clerk (sign-in) ──────────────────────────────────
# dashboard.clerk.com → API keys. The secret key never goes in the web app.
VITE_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# The first Super Admin. Must be the email they sign in to Clerk with.
SEED_ADMIN_EMAIL=""

# ── Google Sheets (Meta Ads leads) ───────────────────
# Service account JSON (base64 encoded) with read access to the sheet only.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=""
# Spreadsheet ID, tab, header mapping and schedule are set in Admin > Integrations.

# ── Telephony (Exotel) ───────────────────────────────
TELEPHONY_PROVIDER="mock"     # mock | exotel
EXOTEL_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_SUBDOMAIN="api.exotel.com"  # api.in.exotel.com for Mumbai cluster
EXOTEL_CALLER_ID=""                # your ExoPhone number
# Random secret appended to the status-callback URL to authenticate webhooks
TELEPHONY_WEBHOOK_SECRET="change-me-webhook-secret"

# ── Production only (docker-compose.prod.yml) ────────
# DOMAIN="crm.yourcompany.in"
# POSTGRES_PASSWORD="long-random-password"
# NODE_ENV=production
# WEB_ORIGIN="https://crm.yourcompany.in"
# PUBLIC_API_URL="https://crm.yourcompany.in"

# ── Hosting on Vercel and Supabase (docs/VERCEL_DEPLOY.md) ──
# Project address. With the secret key set, uploaded files go to Supabase Storage instead of disk.
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SECRET_KEY=""
# Protects the scheduled jobs endpoint. Use a long random value.
# CRON_SECRET=""
